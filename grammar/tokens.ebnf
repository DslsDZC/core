(* 空白与注释 *)
WHITESPACE = { ' ' | '\t' | '\n' | '\r' | COMMENT | BLOCK_COMMENT } ;
COMMENT = '//' { CHAR - '\n' } '\n' ;
BLOCK_COMMENT = '/*' { CHAR | BLOCK_COMMENT } '*/' ;

(* 标识符与关键字 *)
IDENT = LETTER { LETTER | DIGIT | '_' | '\'' } ;
LETTER = 'a'..'z' | 'A'..'Z' | '_' ;
DIGIT = '0'..'9' ;

(* 关键字：以 src/compiler/lexer.cr lookup_keyword() 的实现为准（35 个）。
   2026-08-08 同步：删除未实现的规约关键字 requires/ensures/old/result/self/Self
   （其中 self 在词法中按标识符处理），新增已实现的 while/extern/in。
   注意：self 关键字未实现——T_SELF 是 parser 死分支，实际为 T_IDENT。 *)
KEYWORD =
    'fn' | 'mut' | 'return' | 'if' | 'else' | 'loop' | 'while' | 'for' | 'break' | 'continue' |
    'true' | 'false' | 'struct' | 'enum' | 'extern' | 'impl' | 'match' | 'import' | 'pub' |
    'go' | 'await' | 'unsafe' | 'flow' | 'yield' | 'interface' | 'type' | 'mod' | 'as' |
    'auto' | 'fileid' | 'move' | 'in' | 'None' | 'Some' | 'unit' ;

(* 字面量 *)
(* 数字字面量不支持 '_' 分隔符（lexer.cr：数字扫描仅收 DIGIT；'_' 属 is_alpha（95），
   会被消费为后缀，产生无效 T_INT(-1)；bootstrap lexer 支持 '_'，两实现有分歧——
   以实现为准取不支持） *)
INT_LIT = DIGIT { DIGIT } [ INT_SUFFIX ] ;
INT_SUFFIX = 'i8' | 'i16' | 'i32' | 'i64' | 'u8' | 'u16' | 'u32' | 'u64' ;
(* 3.14 十进制小数 → DEX_LIT（数值迁移：T_FLOAT → T_DEX，见 core.ebnf Literal 注）。
   定点缩放精确解析（int_val = 缩放整数），lexeme 槽保留原数字串（apx 场景由
   str_to_f64_bits 还原 binary64 位模式）。f32/f64 后缀 = apx CPU 位宽标注
   （lexer 消费后缀后统一发 T_DEX——宽度透传为已知缺口，见 numeric-migration-inventory 争议点 7） *)
DEX_LIT = ( DIGIT { DIGIT } [ '.' DIGIT { DIGIT } ] | '.' DIGIT { DIGIT } ) [ 'f32' | 'f64' ] ;
STRING_LIT = '"' { ESCAPED_CHAR } '"' ;
CHAR_LIT = '\'' ( ESCAPED_CHAR | CHAR - '\'' ) '\'' ;
ESCAPED_CHAR = '\' ( 'n' | 't' | 'r' | '0' | '\' | '"' | '\'' ) | '\x' HEX HEX ;
HEX = DIGIT | 'a'..'f' | 'A'..'F' ;

BOOL_LIT = 'true' | 'false' ;
UNIT_LIT = '()' ;

(* 符号 *)
OPERATOR = '+' | '-' | '*' | '/' | '%' | '==' | '!=' | '<' | '>' | '<=' | '>=' | '&&' | '||' | '!' ;
ASSIGN = '=' ;
ARROW = '->' ;
PATH_SEP = '::' ;
DOT = '.' ;
COMMA = ',' ;
SEMI = ';' ;
COLON = ':' ;
COLON_EQ = ':=' ;
LPAREN = '(' ; RPAREN = ')' ;
LBRACK = '[' ; RBRACK = ']' ;
LBRACE = '{' ; RBRACE = '}' ;
AMPERSAND = '&' ;
AT = '@' ;
QUESTION = '?' ;