(* 空白与注释 *)
WHITESPACE = { ' ' | '\t' | '\n' | '\r' | COMMENT | BLOCK_COMMENT } ;
COMMENT = '//' { CHAR - '\n' } '\n' ;
BLOCK_COMMENT = '/*' { CHAR | BLOCK_COMMENT } '*/' ;

(* 标识符与关键字 *)
IDENT = LETTER { LETTER | DIGIT | '_' | '\'' } ;
LETTER = 'a'..'z' | 'A'..'Z' | '_' ;
DIGIT = '0'..'9' ;

(* 关键字：以 src/compiler/lexer.cr lookup_keyword() 的实现为准（35 个）。
   2026-08-08 同步：删除未实现的规约关键字 requires/ensures/old/result/self/Self
   （其中 self 在词法中按标识符处理），新增已实现的 while/extern/in。
   注意：self 关键字未实现——T_SELF 是 parser 死分支，实际为 T_IDENT。 *)
KEYWORD =
    'fn' | 'mut' | 'return' | 'if' | 'else' | 'loop' | 'while' | 'for' | 'break' | 'continue' |
    'true' | 'false' | 'struct' | 'enum' | 'extern' | 'impl' | 'match' | 'import' | 'pub' |
    'go' | 'await' | 'unsafe' | 'flow' | 'yield' | 'interface' | 'type' | 'mod' | 'as' |
    'auto' | 'fileid' | 'move' | 'in' | 'None' | 'Some' | 'unit' ;

(* 字面量 *)
INT_LIT = DIGIT { DIGIT | '_' } [ INT_SUFFIX ] ;
INT_SUFFIX = 'i8' | 'i16' | 'i32' | 'i64' | 'u8' | 'u16' | 'u32' | 'u64' ;
FLOAT_LIT = DIGIT { DIGIT | '_' } '.' DIGIT { DIGIT | '_' } [ 'f32' | 'f64' ] ;
STRING_LIT = '"' { ESCAPED_CHAR } '"' ;
CHAR_LIT = '\'' ( ESCAPED_CHAR | CHAR - '\'' ) '\'' ;
ESCAPED_CHAR = '\' ( 'n' | 't' | 'r' | '0' | '\' | '"' | '\'' ) | '\x' HEX HEX ;
HEX = DIGIT | 'a'..'f' | 'A'..'F' ;

BOOL_LIT = 'true' | 'false' ;
UNIT_LIT = '()' ;

(* 符号 *)
OPERATOR = '+' | '-' | '*' | '/' | '%' | '==' | '!=' | '<' | '>' | '<=' | '>=' | '&&' | '||' | '!' ;
ASSIGN = '=' ;
ARROW = '->' ;
PATH_SEP = '::' ;
DOT = '.' ;
COMMA = ',' ;
SEMI = ';' ;
COLON = ':' ;
COLON_EQ = ':=' ;
LPAREN = '(' ; RPAREN = ')' ;
LBRACK = '[' ; RBRACK = ']' ;
LBRACE = '{' ; RBRACE = '}' ;
AMPERSAND = '&' ;
AT = '@' ;
QUESTION = '?' ;