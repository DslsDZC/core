{
  "name": "core-lang",
  "displayName": "Core Language Support",
  "description": "Syntax highlighting + LSP language server integration for the Core programming language",
  "version": "0.2.0",
  "engines": {
    "vscode": "^1.63.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./client/extension.js",
  "activationEvents": [
    "onLanguage:core"
  ],
  "contributes": {
    "languages": [
      {
        "id": "core",
        "aliases": [
          "Core",
          "core"
        ],
        "extensions": [
          ".cr",
          ".core",
          ".corespec",
          ".coreir"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "core",
        "scopeName": "source.core",
        "path": "./syntaxes/core.tmLanguage.json"
      },
      {
        "language": "core",
        "scopeName": "source.coreir",
        "path": "./syntaxes/coreir.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Core LSP",
      "properties": {
        "corelsp.path": {
          "type": "string",
          "default": "build/corelsp",
          "description": "corelsp 语言服务器二进制路径。绝对路径，或相对第一个工作区根目录（默认 build/corelsp）。"
        },
        "corelsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "是否启用 corelsp 语言服务器（关闭后仅保留语法高亮）。"
        }
      }
    }
  }
}
